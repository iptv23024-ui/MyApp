<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do Cliente"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/purple_700"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/input_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Digite o nome do cliente"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de App"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/purple_700" />

        <Spinner
            android:id="@+id/spinner_app_type"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/input_custom_app"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Digite o nome do app customizado"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAC Address"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/purple_700" />

        <EditText
            android:id="@+id/input_mac"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ex: 00:11:22:33:44:55"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Key"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/purple_700" />

        <EditText
            android:id="@+id/input_device_key"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Digite a chave do dispositivo"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data de Validade da Licença"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/purple_700" />

        <EditText
            android:id="@+id/input_license_date"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Clique para selecionar a data (dd/MM/yyyy)"
            android:inputType="none"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:focusable="false"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:spacing="8dp">

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Salvar"
                android:backgroundTint="@color/purple_500" />

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cancelar"
                android:backgroundTint="@color/teal_700" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>